{
  "name": "@elicitor/anthropic",
  "version": "0.1.0",
  "description": "Anthropic SDK model adapter for Elicitor.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonksar/elicitor.git",
    "directory": "packages/anthropic"
  },
  "homepage": "https://github.com/jonksar/elicitor#readme",
  "bugs": "https://github.com/jonksar/elicitor/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.8.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.8.0 <2"
  },
  "dependencies": {
    "@elicitor/core": "workspace:*"
  }
}
