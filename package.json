{
  "name": "elicitor-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "size": "size-limit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "size-limit": [
    {
      "name": "@elicitor/react-ui",
      "path": "packages/react-ui/dist/index.js",
      "import": "*",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ],
      "limit": "30 kB"
    },
    {
      "name": "@elicitor/capture",
      "path": "packages/capture/dist/index.js",
      "import": "*",
      "limit": "10 kB"
    }
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@size-limit/preset-small-lib": "14.3.0",
    "@types/node": "^22.20.5",
    "size-limit": "14.3.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
